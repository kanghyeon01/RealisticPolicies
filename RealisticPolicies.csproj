<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Built with the game's official modding toolchain (installed from the game's Options > Modding, 2026-11-09):
    Mod.props and Mod.targets come from the toolchain folder (CSII_TOOLPATH). They compile against the game's
    managed assemblies, run the Mod Post Processor (Burst compilation of the mod's jobs) and copy the result into
    the local Mods folder. The hand-written UI module is copied next to it by DeployUI below.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <AssemblyName>RealisticPolicies</AssemblyName>
    <RootNamespace>RealisticPolicies</RootNamespace>
    <Version>0.0.1</Version>
    <Authors>Boing787(kanghyeon01)</Authors>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Only the game's own base libraries (its mscorlib has Span, which game APIs such as BuildingUtils use);
         the .NET Framework 4.8 reference assemblies would clash with it. Mod.props adds the game's mscorlib. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
  </PropertyGroup>

  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

  <!-- The "framework" is the game's own Managed folder, not the .NET Framework 4.8 reference package. -->
  <PropertyGroup>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride>$(ManagedPath)</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.AssetPipeline"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.Collections"><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
    <Reference Include="Unity.Burst"><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="netstandard"><Private>false</Private></Reference>
    <Reference Include="System"><Private>false</Private></Reference>
    <Reference Include="System.Core"><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
    <ModUIFile Include="UI\**\*" />
  </ItemGroup>

  <!--
    The toolchain's Mod Post Processor targets .NET 6, which this PC does not have (only .NET 8, 2026-11-09).
    Until .NET 6 is installed it runs on .NET 8 through the standard roll-forward switch. Same command as Mod.targets.
  -->
  <Target Name="RunModPostProcessor" AfterTargets="AfterBuild" Condition="'$(NeedBuild)'">
    <Error Condition="!Exists('$(ModPostProcessorFullPath)')" Text="Post processor not found, please check the path: $(ModPostProcessorFullPath)" />
    <Message Text="Run post processor: $(ModPostProcessorArgs)" Importance="high" />
    <Exec Command="$(ModPostProcessorArgs)" LogStandardErrorAsError="true" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
  </Target>

  <!-- The UI module (hand-written .mjs, no bundler) goes next to the DLL after the toolchain's own copy. -->
  <Target Name="DeployUI" AfterTargets="DeployWIP" Condition="'$(NeedBuild)'">
    <Copy SourceFiles="@(ModUIFile)" DestinationFiles="@(ModUIFile->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="UI module copied to $(DeployDir)" />
  </Target>

</Project>

